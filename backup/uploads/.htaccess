# Uploaded files must never execute as PHP -- critical if an attacker ever
# manages to upload a disguised .php file.
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php\d?)$">
  Require all denied
</FilesMatch>
Options -Indexes
