<%- include('partials/header') %>

<main class="page" id="main">
  <section class="page-hero" style="border-top-color: #ff2bd6">
    <div class="page-hero-in">
      <div class="page-hero-body">
        <h1><%= settings.community_title || 'Nina.Sucks Community Hub' %></h1>
        <p class="lead"><%= settings.community_tagline || 'The uncensored hub for creator discovery, free expression, and collaborative microblogging.' %></p>
      </div>
    </div>
  </section>

  <!-- Community Profile Card -->
  <div class="panel" style="background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:28px;margin-bottom:36px;">
    <div style="display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap;">
      <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#ff2bd6,#19e3ff);display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;color:#fff;">
        N
      </div>
      <div style="flex:1;min-width:280px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
          <h2 style="font:800 24px var(--f-display);margin:0;"><%= settings.community_title || 'Nina.Sucks Official' %></h2>
          <%- badge('vip') %>
          <%- badge('id') %>
        </div>
        <p style="color:var(--mute);line-height:1.6;font-size:15px;margin-bottom:18px;white-space:pre-line;">
          <%= settings.community_bio || "Welcome to the uncensored home for creator discovery.\nConnect with like-minded creators, share stories, quotes, photos and chats without algorithmic barriers.\nCreate unlimited blogs, customize your pages, and earn points to boost your reach across the network." %>
        </p>

        <!-- 3 Website Links and 1 Contact Email -->
        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
          <% if (settings.community_url1) { %>
            <a href="<%= settings.community_url1 %>" target="_blank" rel="noopener" class="btn btn-line btn-xs" style="display:inline-flex;align-items:center;gap:6px;">
              <%- icon('link') %> <span>Website</span>
            </a>
          <% } %>
          <% if (settings.community_url2) { %>
            <a href="<%= settings.community_url2 %>" target="_blank" rel="noopener" class="btn btn-line btn-xs" style="display:inline-flex;align-items:center;gap:6px;">
              <%- icon('link') %> <span>Twitter / X</span>
            </a>
          <% } %>
          <% if (settings.community_url3) { %>
            <a href="<%= settings.community_url3 %>" target="_blank" rel="noopener" class="btn btn-line btn-xs" style="display:inline-flex;align-items:center;gap:6px;">
              <%- icon('link') %> <span>Telegram</span>
            </a>
          <% } %>
          <% if (settings.community_email) { %>
            <a href="mailto:<%= settings.community_email %>" class="btn btn-ghost btn-xs" style="display:inline-flex;align-items:center;gap:6px;color:var(--cyan);">
              <%- icon('mail') %> <span><%= settings.community_email %></span>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Community Highlights & Spotlight Blogs -->
  <h2 class="sec-title">Featured Creator Spotlights</h2>
  <p class="sec-sub">Staff picks, active blogs, and community leaders.</p>

  <div class="tiles tiles-3" style="margin-bottom:40px;">
    <% featuredBlogs.forEach(function(b) { %>
      <div class="tile" style="--c:<%= b.color || '#ff2bd6' %>">
        <%- icon('compass') %>
        <h3><a href="/blog/<%= b.slug %>" style="color:inherit;text-decoration:none;">@<%= b.slug %></a></h3>
        <p><%= b.title %></p>
        <small style="color:var(--mute);"><%= b.tagline || 'Creator blog' %></small>
        <div style="margin-top:12px;">
          <a class="btn btn-xs btn-fill" href="/blog/<%= b.slug %>">Visit Blog</a>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Recent Community Discussions & Posts -->
  <h2 class="sec-title">Latest From the Community</h2>
  <div class="posts" id="posts-container" style="max-width:680px;margin:0 auto;">
    <% communityPosts.forEach(function(post) { %>
      <%- include('partials/card', { p: post }) %>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>
