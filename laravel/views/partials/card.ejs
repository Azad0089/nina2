<%
  const color = p.color || '#ff2bd6';
  const type = p.type;
  const isLiked = typeof likedPosts !== 'undefined' && likedPosts.has(p.id);
  const isFollowing = typeof followedBlogs !== 'undefined' && followedBlogs.has(p.blog_id || p.blog);
  const isMine = currentUser && (currentUser.blog === p.blog || currentUser.username === p.blog);
%>
<article class="card t-<%= type %>" data-type="<%= type %>" data-post-id="<%= p.id %>" style="--c:<%= color %>">
  <header class="c-head">
    <a href="<%= url('blog.php?u=' + encodeURIComponent(p.blog)) %>" style="display:contents">
    <% if (p.avatar) { %>
      <img class="av" src="<%= media_url(p.avatar) %>" alt="" width="36" height="36" loading="lazy">
    <% } else { %>
      <span class="av" style="--c:<%= color %>"><%= initial(p.blog) %></span>
    <% } %>
    </a>
    <div class="c-who">
      <b><a href="<%= url('blog.php?u=' + encodeURIComponent(p.blog)) %>"><%= p.blog %></a> <%- badge(p.badge || '') %></b>
      <small><%= type %> post</small>
    </div>
    <% if (!isMine) { %>
      <button class="follow<%= isFollowing ? ' on' : '' %>" type="button" data-blog="<%= p.blog %>"><%= isFollowing ? 'Following' : 'Follow' %></button>
    <% } %>
  </header>

<% if (type === 'photo' || type === 'video') { %>
  <figure class="media crop" style="<%= crop_style(p.crop || {}) %>">
    <img src="<%= media_url(p.img || 'hero.jpg') %>" alt="<%= p.alt || p.caption || '' %>" loading="lazy" decoding="async">
    <% if (type === 'video') { %>
      <video controls preload="none" poster="" style="display:none"></video>
      <button class="play" type="button" aria-label="Play video" data-video-src="<%= media_url(p.img || 'hero.jpg') %>"><%- icon('play') %></button>
      <span class="dur"><%= p.duration || '0:30' %></span>
    <% } %>
  </figure>
  <div class="c-body"><p><%= p.caption || '' %></p>

<% } else if (type === 'text') { %>
  <div class="blk"><h3><%= p.heading || '' %></h3><p><%- (p.body || '').replace(/\n/g, '<br>') %></p></div>
  <div class="c-body">

<% } else if (type === 'quote') { %>
  <div class="c-body">
    <blockquote><p><%= p.quote || '' %></p><cite><%= p.source || '' %></cite></blockquote>

<% } else if (type === 'link') { %>
  <a class="lk" href="<%= p.url || '#' %>" target="_blank" rel="nofollow noopener">
    <div class="lk-t"><%- icon('link') %></div>
    <div><b><%= p.title || '' %></b><small><%= p.domain || '' %></small></div>
  </a>
  <div class="c-body">

<% } else if (type === 'chat') { %>
  <div class="chat">
    <% (p.lines || []).forEach(function(l) { %>
      <p><b><%= l[0] %>:</b><%= l[1] %></p>
    <% }); %>
  </div>
  <div class="c-body">
<% } %>

    <% if (p.tags && p.tags.length) { %>
      <div class="tags">
        <% p.tags.forEach(function(t) { %>
          <a href="<%= url('trending.php?tag=' + encodeURIComponent(t)) %>">#<%= t %></a>
        <% }); %>
      </div>
    <% } %>
  </div>

  <footer class="c-foot">
    <a class="act" href="<%= url('post.php?id=' + p.id) %>#comments" aria-label="View comments" title="Comments and Discussion"><%- icon('chat') %><span><%= (p.comments ? p.comments.length : 0) %></span></a>
    <button class="act reblog" type="button" aria-label="Reblog" data-post-id="<%= p.id %>" title="Reblog to your blog"><%- icon('repeat') %><span><%= fmt_count(p.reblog_count || 0) %></span></button>
    <button class="act like<%= isLiked ? ' on' : '' %>" type="button" aria-label="Like" data-post-id="<%= p.id %>"><%- icon('heart') %><span><%= fmt_count(p.like_count || 0) %></span></button>
    <span class="ago"><%= time_ago(p.minutes || 5) %> ago</span>
    <button class="act report" type="button" aria-label="Report" data-post-id="<%= p.id %>" title="Report this post"><%- icon('flag') %></button>
  </footer>
</article>
